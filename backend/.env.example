# Copier ce fichier vers backend/.env puis renseigner les valeurs.
# Aucune valeur reelle ne doit etre committee.

# Connexion PostgreSQL (adapter utilisateur / mot de passe / nom de base)
DATABASE_URL=postgresql+psycopg2://utilisateur:motdepasse@localhost:5432/saamaya

# Cle de signature des JWT (longue chaine aleatoire, 32 caracteres minimum)
JWT_SECRET=

# Mots de passe initiaux (utilises uniquement par python -m app.init_db)
ADMIN_PASSWORD=
MARCHAND_000101_PASSWORD=
MARCHAND_000102_PASSWORD=

# Base dediee aux tests pytest (ne jamais pointer vers la base de developpement)
TEST_DATABASE_URL=postgresql+psycopg2://utilisateur:motdepasse@localhost:5432/saamaya_test
